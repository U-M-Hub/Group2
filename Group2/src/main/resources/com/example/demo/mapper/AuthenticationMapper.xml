<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.AuthenticationMapper">

	<!-- ユーザー名で、ユーザー情報を取得 -->
	<select id="selectUserByUserName" resultType="com.example.demo.entity.Users">
		SELECT * FROM users
		WHERE user_name = #{userName}
	</select>

</mapper>